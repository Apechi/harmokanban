{
  "name": "kanban-harmo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,signal -c cyan,yellow \"npm run dev:next\" \"npm run dev:signal\"",
    "dev:next": "next dev --hostname 0.0.0.0",
    "dev:signal": "node -e \"process.env.PORT=4444; process.env.HOST='0.0.0.0'; require('./node_modules/y-webrtc/bin/server.js')\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
